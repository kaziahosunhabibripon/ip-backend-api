{
  "name": "ipscope-api",
  "version": "0.0.1",
  "description": "NestJS backend for IPScope",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "clean:dist": "node -e \"require('fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "npm run clean:dist && nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "cross-env NODE_ENV=development nest start",
    "start:dev": "cross-env NODE_ENV=development nest start --watch",
    "start:debug": "cross-env NODE_ENV=development nest start --debug --watch",
    "start:prod": "cross-env NODE_ENV=production node dist/main",
    "lint": "eslint \"{src,test}/**/*.ts\"",
    "lint:fix": "eslint \"{src,test}/**/*.ts\" --fix",
    "db:generate": "cross-env NODE_ENV=development drizzle-kit generate",
    "db:migrate": "cross-env NODE_ENV=development drizzle-kit migrate",
    "db:studio": "cross-env NODE_ENV=development drizzle-kit studio",
    "admin:grant": "cross-env NODE_ENV=development ts-node src/admin/admin-role.cli.ts grant",
    "dev:set-plan": "cross-env NODE_ENV=development ts-node src/dev/set-plan.cli.ts",
    "admin:revoke": "cross-env NODE_ENV=development ts-node src/admin/admin-role.cli.ts revoke",
    "test": "cross-env \"NODE_OPTIONS=--experimental-vm-modules --disable-warning=ExperimentalWarning\" jest",
    "test:watch": "cross-env \"NODE_OPTIONS=--experimental-vm-modules --disable-warning=ExperimentalWarning\" jest --watch",
    "test:cov": "cross-env \"NODE_OPTIONS=--experimental-vm-modules --disable-warning=ExperimentalWarning\" jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "cross-env \"NODE_OPTIONS=--experimental-vm-modules --disable-warning=ExperimentalWarning\" jest --config ./test/jest-e2e.json"
  },
  "dependencies": {
    "@ip-location-db/asn-mmdb": "^2.3.2026061719",
    "@ip-location-db/dbip-city-mmdb": "^2.3.2026060513",
    "@nestjs/common": "^12.1.0",
    "@nestjs/config": "^12.0.1",
    "@nestjs/core": "^12.1.0",
    "@nestjs/drizzle": "^0.0.1",
    "@nestjs/platform-express": "^12.1.0",
    "@nestjs/swagger": "^12.0.2",
    "@nestjs/throttler": "^6.7.0",
    "@paralleldrive/cuid2": "^2.2.2",
    "@sentry/node": "^11.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.3",
    "compression": "^1.8.2",
    "cookie-parser": "^1.4.7",
    "dotenv": "^16.4.7",
    "drizzle-orm": "^0.45.3",
    "helmet": "^8.3.0",
    "ioredis": "^6.0.0",
    "maxmind": "^5.0.7",
    "nestjs-pino": "^5.2.1",
    "nodemailer": "^10.0.10",
    "pg": "^8.17.2",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "tldts": "^7.4.15",
    "tz-lookup": "^6.1.25"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.18.0",
    "@nestjs/cli": "^12.0.5",
    "@nestjs/schematics": "^12.0.5",
    "@nestjs/testing": "^12.1.0",
    "@types/compression": "^1.8.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.13.6",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.16.0",
    "@types/supertest": "^6.0.2",
    "@types/tz-lookup": "^6.1.2",
    "cross-env": "^10.1.0",
    "drizzle-kit": "^0.31.5",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.2",
    "globals": "^16.0.0",
    "jest": "^30.0.0",
    "pino-pretty": "^13.1.3",
    "prettier": "^3.4.2",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.20.0"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  }
}
